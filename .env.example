# Hearsay configuration (§4.1). Copy to .env — .env is gitignored and never read by
# anything but this process. Keys live here and nowhere else: they are never written to
# the database, printed to logs, included in exports, or rendered unmasked in the UI.
#
# Parser limitations, on purpose (no dotenv dependency): KEY=VALUE lines only, "#" starts
# a comment line, values are trimmed, one matching pair of surrounding quotes is removed.
# No interpolation, no multi-line values. Real environment variables win over this file.

# ---- server ----
# 0 = let the operating system choose a free local port. Set a positive value only
# when a reverse proxy or another script needs a fixed port.
PORT=0
# Bind address. Keep the loopback default unless you have read SECURITY.md.
HOST=127.0.0.1
HEARSAY_DB_PATH=./data/hearsay.db
# Optional discovery-file override for service managers or custom data locations.
# HEARSAY_PORT_FILE=./data/hearsay.port
# Optional directory for restricted subscription-agent working dirs and redacted
# provider-event artifacts. Never point this at a project checkout.
# HEARSAY_DATA_DIR=./data

# ---- sampling design ----
# Daily panel run, server local time, HH:MM.
HEARSAY_RUN_AT=07:00
# Samples per prompt per provider per run (1–10). More samples, tighter intervals.
HEARSAY_SAMPLES=3
# Parallel in-flight LLM calls.
HEARSAY_CONCURRENCY=2
# Per-call timeout in milliseconds.
HEARSAY_TIMEOUT_MS=45000
# Runs estimated above this many dollars (or >200 calls, or with unknown cost) return a
# cost quote first and need {"confirm":true,"quote_id":"<preview quoteId>"} to start.
# 0 = always quote first.
HEARSAY_CONFIRM_USD=1

# 1 = demo mode: auto-seed when the DB is empty, disable live calls and the scheduler,
# and label every page as demo data.
HEARSAY_DEMO=0

# ---- providers (bring your own keys) ----
# A provider is enabled if and only if its key is non-empty. Zero keys is fine: the app
# still runs and the dashboard says what is missing.
# Model defaults are set in core/config.js and were checked against current official docs;
# uncomment a MODEL line only to pin something different.
# OpenAI defaults to search off. Opt into Responses web_search with auto or required
# on the validated gpt-5.6-luna model. On-demand runs then require a quote. The
# existing daily schedule stays search off until separate recurring consent.
# Anthropic and Gemini API search remain unavailable. Sonar is legacy retrieval.

OPENAI_API_KEY=
# OPENAI_MODEL=gpt-5.6-luna
HEARSAY_OPENAI_SEARCH_POLICY=off

ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5

GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash

PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar

# ---- optional subscription-agent surfaces ----
# Disabled by default. Enable only on a machine where the CLI is installed and
# already authenticated with the user's subscription. Hearsay never copies that login.
HEARSAY_CODEX_ENABLED=0
# HEARSAY_CODEX_PATH=codex
HEARSAY_CLAUDE_CODE_ENABLED=0
# HEARSAY_CLAUDE_CODE_PATH=claude
# Subscription defaults are allowance-safe and separate from API sampling settings.
# The CLI prompt requires search. The CLI process has a time/output bound, but Hearsay
# cannot enforce a ceiling on web searches made internally by the CLI.
# HEARSAY_SUBSCRIPTION_SAMPLES=1
# HEARSAY_SUBSCRIPTION_CONCURRENCY=1
# HEARSAY_SUBSCRIPTION_TIMEOUT_MS=120000
# HEARSAY_SUBSCRIPTION_IDLE_TIMEOUT_MS=30000
# HEARSAY_SUBSCRIPTION_MAX_OUTPUT_BYTES=2097152

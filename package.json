{
  "name": "@melonwer/hearsay",
  "version": "0.1.0",
  "private": false,
  "publishConfig": {
    "access": "public"
  },
  "description": "Open-source AI-search forensics and measurement for technical SEOs and builders: zero-key crawlability pre-flight audits, retrieval-to-citation attrition, memory-vs-search deltas, and multi-wave citation persistence.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "hearsay": "./bin/hearsay.js"
  },
  "files": [
    "bin/",
    "core/",
    "web/",
    "public/",
    "mcp/",
    "server.js",
    "skill/",
    "README.md",
    "METHODOLOGY.md",
    "LICENSE",
    "SECURITY.md",
    ".env.example"
  ],
  "keywords": [
    "ai-search",
    "ai-visibility",
    "seo",
    "technical-seo",
    "geo",
    "forensics",
    "citations",
    "retrieval",
    "robots-txt",
    "mcp",
    "sqlite",
    "markdown"
  ],
  "homepage": "https://melonwer.github.io/hearsay/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/melonwer/hearsay.git"
  },
  "bugs": {
    "url": "https://github.com/melonwer/hearsay/issues"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "seed": "node scripts/seed.js",
    "run-panel": "node scripts/run-panel.js",
    "suggest-prompts": "node scripts/suggest-prompts.js",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "check:runtime-deps": "node scripts/check-runtime-deps.js",
    "build:bundles": "node scripts/build-bundles.js",
    "verify:bundles": "node scripts/verify-skill-discovery.js",
    "verify:plugin-runtime": "node scripts/verify-plugin-runtime.js"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "webforai": "^5.1.0"
  }
}

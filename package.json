{
  "name": "hearsay",
  "version": "0.1.0",
  "private": true,
  "description": "App visibility research in your current agent, with optional account measurements, scheduling and dashboard imports.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "hearsay": "./bin/hearsay.js"
  },
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node server.js",
    "test": "node --test",
    "seed": "node scripts/seed.js",
    "run-panel": "node scripts/run-panel.js",
    "suggest-prompts": "node scripts/suggest-prompts.js",
    "typecheck": "tsc -p jsconfig.json --noEmit",
    "build:bundles": "node scripts/build-bundles.js",
    "verify:bundles": "node scripts/verify-skill-discovery.js"
  }
}
